# =====================================================================
# Hunar monorepo: client/ (Vite + React) and server/ (Express + MongoDB)
# =====================================================================

# --- Dependencies ----------------------------------------------------
# A bare "node_modules/" already matches at any depth; the explicit lines
# below make it obvious that both packages are covered.
node_modules/
**/node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# --- Build output ----------------------------------------------------
dist/
client/dist/
server/dist/
build/
out/
.vite/
.cache/
.next/
*.tsbuildinfo

# Generated by TanStack Router (npm run dev, build and typecheck recreate it). It is machine
# written with type-check overrides, so it is not committed.
client/src/routeTree.gen.ts

# --- Environment and secrets -----------------------------------------
# Never commit real values. The .example files document the variable names.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.key
secrets/

# --- Logs ------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- Tests, coverage and lint caches ---------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
.eslintcache

# --- Large source artwork --------------------------------------------
# The app uses the optimized naka-workers.jpg next to this file; the 2.6 MB
# original is not needed at runtime. Remove this line to track it.
client/public/images/naka-workers.png

# --- Local tooling output --------------------------------------------
settings.local.json
graphify-out/

# --- Operating system files ------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Editors and IDEs ------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# --- Intentionally tracked (do not add above) ------------------------
# package-lock.json in the root, client/ and server/ (reproducible installs)
# server/.env.example
