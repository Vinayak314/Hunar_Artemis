# Copy to server/.env and fill in real values. Never commit server/.env.

# MongoDB connection string. The database named in the path (e.g. /hunar) is used.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hunar?appName=Hunar

# Optional: override the database name from the URI (the test suite sets this to hunar_test).
# MONGODB_DB=hunar

# Google Gemini API key. Used only on the server; never expose it to the browser.
GEMINI_API_KEY=

# Gemini model for the job-writing helper. Check that your key can use it (npm run check).
GEMINI_MODEL=gemini-3.5-flash
# Lighter model used when the main one is overloaded.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

PORT=4000

# Comma-separated browser origins allowed to call the API with cookies.
# Only needed when the client is hosted on a different origin than the API.
CLIENT_ORIGIN=http://localhost:3000

# Days a sign-in lasts.
SESSION_TTL_DAYS=30

# Use "none" only if client and API are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax

# Optional: folder of the built client to serve (default: ../client/dist).
# CLIENT_DIST=
